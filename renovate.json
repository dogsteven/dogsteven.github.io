{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Etc/UTC",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "astro site dependencies"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "description": "@astrojs/check peers on typescript ^5 || ^6 — npm ci fails on 7. Lift when a TS7-compatible @astrojs/check ships."
    }
  ]
}
