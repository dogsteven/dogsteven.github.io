---
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
---

<Layout
  title="About - Khoa Huynh Bach"
  description="A passionated software engineer."
  canonicalPath="/about/"
>
  <main class="content-shell" data-pagefind-body>
    <div class="page-hero">
      <h1 class="visually-hidden">About</h1>
      <TypedLede text="A passionated software engineer." />
    </div>

    <div class="section" style="max-width: var(--max);">
      <div class="about-grid">
        <div class="about-me">
          <div class="about-card">
            <h3>About</h3>
            <div class="about-prose">
              <p>My name is Khoa Huynh Bach. I'm a software engineer with strong passion in system design, distributed systems, and computer graphics.</p>
              <p>Currently, I'm working on many projects including backend frameworks, a distributed scheduler, and a game engine.</p>
              <p>This blog is where I share my knowledge and track my progress. Hope you enjoy.</p>
            </div>
          </div>
        </div>

        <aside>
          <div class="sidebar-card">
            <h3>Education</h3>
            <div class="edu-entry">
              <p class="edu-degree">Bachelor Degree, Computer Science</p>
              <p class="edu-school"><a href="https://hcmut.edu.vn/" target="_blank" rel="noopener" style="color: var(--accent);">Ho Chi Minh City's University, University of Technology</a> 2018</p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <SkillsMarquee />
  </main>
</Layout>
